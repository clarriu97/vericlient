layout_pdm() {
    if ! command -v pdm >/dev/null 2>&1; then
        log_error "pdm is not installed"
        return 1
    fi
    VIRTUAL_ENV=$(pdm venv list | grep "in-project" | awk -F" " '{print $3}')

    if [ -z "$VIRTUAL_ENV" ] || [ ! -d "$VIRTUAL_ENV" ]; then
        log_status "Creating a virtual environment"
        # No version pin here: the project supports every Python from 3.11 on,
        # so let PDM pick an interpreter that satisfies `requires-python`.
        pdm venv create
        log_status "Executing \`pdm install --dev\` to install the dependencies."
        pdm install --dev
        VIRTUAL_ENV=$(pdm venv list | grep "in-project" | awk -F" " '{print $3}')
    fi

    PATH_add "$VIRTUAL_ENV/bin"
    export PDM_ACTIVE=1
    export VIRTUAL_ENV
}

layout pdm
